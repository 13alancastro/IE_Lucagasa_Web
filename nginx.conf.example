# Ejemplo de despliegue: nginx sirve el frontend y hace proxy de la API.
server {
    listen 80;
    server_name www.lucagasa.edu.co lucagasa.edu.co;

    # Redirección a HTTPS (descomenta cuando tengas certificado)
    # return 301 https://$host$request_uri;

    root /var/www/lucagasa;
    index index.html;

    # Frontend estático
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "public, max-age=3600";
    }

    # API (proceso Node en el puerto 3000)
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://127.0.0.1:3000;
        access_log off;
    }

    # Archivos del sitio
    location = /robots.txt { allow all; }
    location = /sitemap.xml { allow all; }
}
