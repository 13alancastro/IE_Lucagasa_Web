# Servidores
PORT=3000
FRONTEND_PORT=8080
HOST=0.0.0.0

# Base de datos
DATABASE_PATH=data/document-requests.sqlite

# Administrador (¡CAMBIA LA CONTRASEÑA!)
ADMIN_EMAIL=correo@institucion.gov.co
ADMIN_PASSWORD=CambiaEstaClaveAdmin2026

# Seguridad / despliegue
# Si la web y la API están en dominios distintos, pon aquí el origen de la web:
# CORS_ORIGIN=https://www.lucagasa.edu.co
CORS_ORIGIN=

# Respaldo automático de la base de datos (horas y número de copias a conservar)
