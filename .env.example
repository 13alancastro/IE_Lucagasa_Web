BACKUP_KEEP=7

# Correo SMTP (déjalo vacío para desactivar los avisos por correo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
