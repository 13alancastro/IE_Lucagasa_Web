# Servidores
PORT=3000
FRONTEND_PORT=8080
HOST=0.0.0.0

# Base de datos
DATABASE_PATH=data/document-requests.sqlite

# Administrador (¡CAMBIA LA CONTRASEÑA!)
ADMIN_EMAIL=correo@institucion.gov.co
ADMIN_PASSWORD=CambiaEstaClaveAdmin2026

# Seguridad / despliegue
# Si la web y la API están en dominios distintos, pon aquí el origen de la web:
# CORS_ORIGIN=https://www.lucagasa.edu.co
CORS_ORIGIN=

# Respaldo automático de la base de datos (horas y número de copias a conservar)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Correo SMTP (déjalo vacío para desactivar los avisos por correo)
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Microsoft 365:    SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
# Servidor propio:  SMTP_HOST=mail.tudominio.com, SMTP_PORT=465, SMTP_SECURE=true
# SMTP_PASS debe ser una "contraseña de aplicación", NO la contraseña normal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
